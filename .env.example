# Server only. Copy to .env.local for development; never commit real values.
ENSAMBLIA_QUOTE_MODE=demo
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Supabase integration. All environments can read the public catalog.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Production only: never expose these to the browser or untrusted previews.
SUPABASE_SECRET_KEY=
CATALOG_SYNC_SECRET=
# Legacy SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are accepted as fallback.
