# Server only. Copy to .env.local for development; never commit real values.
ENSAMBLIA_QUOTE_MODE=demo
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Names supplied automatically by the Vercel Upstash integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternatively, a complete UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# pair is supported. Do not use the read-only token: catalog updates write data.
# Use the SAME namespace and database in Production and Preview to share downloads.
CATALOG_CACHE_NAMESPACE=ensamblia:catalog:v1
